# --- Server ---
PORT=3001
NODE_ENV=development
# CORS: panelin kostugu origin. Panel baska bir porttaysa burayi da guncelle.
FRONTEND_URL=http://localhost:3000

# --- Panel (frontend/) ---
# Panelin motoru aradigi adres. frontend/.env.local icine yazilir, buraya DEGIL —
# NEXT_PUBLIC_* degiskenleri tarayici paketine gomulur ve Next.js onlari yalnizca
# kendi dizininden okur. Varsayilan http://localhost:3001/api oldugu icin yerelde
# hicbir sey ayarlamak gerekmez.
#   frontend/.env.local:  NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Firebase (state: backtests, champion, papers, runs) ---
# Service account JSON'u Firebase Console > Project Settings > Service accounts >
# "Generate new private key" ile indir, repo kokune 'serviceaccount.json' olarak koy
# (gitignore'da — repoya girmez). Baska bir yer/isim kullanacaksan yolu burada ver.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceaccount.json

# --- Binance Futures ---
# TESTNET=true iken emirler testnet'e gider. Canli para icin bilincli olarak false yapilmali
# (ve ayrica --allow-mainnet bayragi sart; tek basina bu satir yetmez).
# Testnet anahtarlari: https://testnet.binancefuture.com
# NOT: Public veri (mum/funding) HER ZAMAN mainnet'ten cekilir — testnet'in tarihsel
# verisi seyrektir. Yalnizca EMIR trafigi testnet'e gider.
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Canli execution ---
# false (varsayilan): zamanlayici her mum kapanisinda kosar ama KURU — ne yapacagini
#   loglar, emir GONDERMEZ. Motoru risksiz izlemek icin.
# true: gercekten emir gonderir (BINANCE_TESTNET=true ise testnet'e).
# ONCE PARITE: `npx tsx scripts/parity.ts` yesil yanmadan true yapma.
LIVE_TRADING=false

# --- Makale secen LLM (OpenAI-uyumlu route) ---
# Gece dongusunun 3. asamasi: arXiv havuzunu okuyup gecenin makalesini secer.
# Kapatma anahtari LLM_BASE_URL'dir: bosaltilirsa secici devre disi kalir ve gece eski
# deterministik anahtar kelime siralayicisina duser (kosar, ama kor kosar — rapor bunu
# 'heuristic' diye isaretler). Proxy anahtarsiz da cevap veriyor; LLM_API_KEY yalnizca
# gerekiyorsa doldurulur.
LLM_BASE_URL=https://api.interneteco.systems/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_MS=120000
# Bir gecede modele okutulacak makale tavani (maliyet freni). Tavani asan havuzda
# EN YENI makaleler tutulur.
LLM_MAX_PAPERS=240

# --- Codex ---
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
CODEX_TURN_TIMEOUT_MS=1800000

# --- Bildirim (opsiyonel; bos ise mail atlanir) ---
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
NOTIFICATION_FROM_NAME=TradeCraft AI

# --- Gece dongusu ---
# Sampiyonun uzerinde kosacagi semboller ve zaman dilimi
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
CANDLE_INTERVAL=4h
# Backtest penceresi (gun)
BACKTEST_DAYS=540
# Secimde ASLA kullanilmayan holdout ("kasa") penceresi (gun)
HOLDOUT_DAYS=90
# Gece dongusu cron (UTC)
NIGHTLY_CRON=30 2 * * *
